# PostgreSQL
POSTGRES_DB=iot_anomaly
POSTGRES_USER=iot-user
POSTGRES_PASSWORD=iot-password
DB_HOST=localhost
DB_PORT=5432

# Set automatically by docker-compose; override for local dev
DATABASE_URL=postgresql://postgres:iot-password@localhost:5432/iot_anomaly

# Pipeline config
CHANNEL=P-1           # SMAP channel to process (e.g. P-1, S-1, E-1 for SMAP; M-1 for MSL)
BATCH_SIZE=500        # Rows per write batch
IF_CONTAMINATION=0.05 # Fraction of training data assumed anomalous for Isolation Forest
ZSCORE_WINDOW=100     # Rolling window length for Z-score detector
ZSCORE_THRESHOLD=3.0  # |z| threshold above which a point is flagged
